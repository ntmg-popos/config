

#######################################################################################
# HYPRLAND CONFIG
#######################################################################################

### МОНИКИ

# Второй монитор (HDMI-A-1) — вертикальный, по центру над основным
monitor = HDMI-A-1, 1920x1200@59.95000, auto-left, 1.07

# Основной монитор ноутбука (eDP-1) — ставим его под вертикальным
monitor = desc:China Star Optoelectronics Technology Co. Ltd MNG007QX2-1, 1920x1200@144, 0x0, 1.25

$terminal = kitty
$fileManager = dolphin
$menu = hyprlauncher

#################
### AUTOSTART ###
#################
exec-once = dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=Hyprland
# exec-once = ~/.config/hypr/scripts/reset-portals.sh &
exec-once = nm-applet &
exec-once = brave_browser
exec-once = swww-daemon &
exec-once = swww init
exec-once = waypaper --restore 
exec-once = waybar &
exec-once = eww daemon
exec-once = eww open clock
exec-once = eww open music
exec-once = eww open screen_time
exec-once = python3 /home/c074rd/.local/bin/track_time.py --serve
exec-once = gpu-screen-recorder &
exec-once = wl-paste --type text --watch cliphist store
exec-once = wl-paste --type image --watch cliphist store
#############################
### ENVIRONMENT VARIABLES ###
#############################
env = XCURSOR_SIZE,20
#env = XCURSOR_THEME,adwaita_cursors

#####################
### LOOK AND FEEL ###
#####################
general {
    gaps_in = 6
    gaps_out = 4
    border_size = 3
    col.active_border = rgb(24593a) rgb(6f8076) 180deg
    col.inactive_border = 0x00ffffff
    resize_on_border = false
    allow_tearing = false
    layout = dwindle
}

decoration {
    rounding = 4
    active_opacity = 0.98
    inactive_opacity = 0.90
    blur {
        enabled = true
        size = 0
        passes = 1
    }
}

animations {
    enabled = yes    
    bezier = sharpIn, 0.76, 0, 0.24, 1

    animation = windows, 1, 1, sharpIn, slide
    animation = windowsIn, 1, 1.3, sharpIn, slide
    animation = windowsOut, 1, 1.3, sharpIn, slide
    animation = windowsMove, 1, 1.7, sharpIn, slide
    animation = border, 1, 1, sharpIn
    animation = fade, 1, 1, sharpIn
    animation = workspaces, 1, 1.5, sharpIn
}

dwindle {
    # pseudotile = true
    preserve_split = true
}

master {
    new_status = master
}

misc {
    force_default_wallpaper = -1
    disable_hyprland_logo = true
}

#############
### INPUT ###
#############
input {
    kb_layout = us,ua,ru
    kb_options = grp:win_space_toggle
    follow_mouse = 1
    sensitivity = 0
    touchpad {
        natural_scroll = false
    }
}

###################
### KEYBINDINGS ###
###################
$mainMod = SUPER

# Основные бинды
bind = $mainMod, Q, exec, $terminal
bind = $mainMod ALT, Q, exec, $terminal bash -c "fastfetch; bash"
bind = $mainMod, C, killactive,
bind = $mainMod, E, exec, $fileManager
bind = $mainMod, R, exec, $menu
bind = ALT, SPACE, exec, rofi -show drun -theme ~/.config/rofi/launchers/type-1/style-4.rasi -sort -sorting-method fzf
bind = $mainMod, B, exit,
bind = $mainMod, G, exec, wlogout
bind = $mainMod, N, exec, swaync-client -t -sw
bind = $mainMod, O, exec, [float; size 800 600; center] waypaper
# Скрыть все окна по бинду Super + D
bind = SUPER, Z, togglespecialworkspace, desktop
# Назначаем хоткей (например, Super + Tab) на скрытый терминал
#bind = $mainMod, Tab, togglespecialworkspace, magic
# Правило, чтобы окно терминала было плавающим на этом воркспейсе
#windowrule = float, ^(kitty)$
# Скриншоты (в буфер обмена)
bind = , Print, exec, grim -o $(hyprctl monitors | grep -o 'eDP-[0-9]') - | wl-copy --type image/png
bind = SHIFT, Print, exec, grim -g "$(slurp)" - | wl-copy --type image/png

# Изменение размера окон
binde = $mainMod, left, resizeactive, -20 0
binde = $mainMod, right, resizeactive, 20 0
binde = $mainMod, up, resizeactive, 0 -20
binde = $mainMod, down, resizeactive, 0 20

# Смена фокуса (Changing focus)
bind = $mainMod SHIFT, left, movefocus, l
bind = $mainMod SHIFT, right, movefocus, r
bind = $mainMod SHIFT, up, movefocus, u
bind = $mainMod SHIFT, down, movefocus, d

# Смена окон местами (Swapping windows)
# По горизонтали (Super + Alt + Left/Right)
bind = $mainMod ALT, left, swapwindow, l
bind = $mainMod ALT, right, swapwindow, r
# По вертикали (Super + Alt + Up/Down)
bind = $mainMod ALT, up, swapwindow, u
bind = $mainMod ALT, down, swapwindow, d

bind = $mainMod, 1, workspace, 1
bind = $mainMod, 2, workspace, 2
bind = $mainMod, 3, workspace, 3
bind = $mainMod, 4, workspace, 4
bind = $mainMod, 5, workspace, 5

bind = $mainMod SHIFT, 1, movetoworkspace, 1
bind = $mainMod SHIFT, 2, movetoworkspace, 2
bind = $mainMod SHIFT, 3, movetoworkspace, 3
bind = $mainMod SHIFT, 4, movetoworkspace, 4
bind = $mainMod SHIFT, 5, movetoworkspace, 5

# Медиа-клавиши
bindel = ,XF86AudioRaiseVolume, exec, wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindel = ,XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindel = ,XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindel = ,XF86MonBrightnessUp, exec, brightnessctl set 5%+
bindel = ,XF86MonBrightnessDown, exec, brightnessctl set 5%-

# Мышь
bindm = $mainMod, mouse:272, movewindow
bindm = $mainMod, mouse:273, resizewindow

# режимы 
bind = $mainMod, V, togglefloating,
bind = $mainMod, F, fullscreen,
bind = $mainMod, P, pseudo,

bind = $mainMod, J, layoutmsg, togglesplit

bind = $mainMod, L, exec, hyprlock

###

xwayland {
    force_zero_scaling = true
}

bind = $mainMod, K, exec, [float] qalculate-gtk

### WORKSPACE BIND FOR MONITORS

workspace = 1, monitor:desc:China Star Optoelectronics Technology Co. Ltd MNG007QX2-1
workspace = 2, monitor:desc:China Star Optoelectronics Technology Co. Ltd MNG007QX2-1
workspace = 3, monitor:desc:China Star Optoelectronics Technology Co. Ltd MNG007QX2-1

workspace = 4, monitor:HDMI-A-1
workspace = 5, monitor:HDMI-A-1
workspace = 6, monitor:HDMI-A-1


# ТАЧПАД

gestures {
    # Включаем плавный горизонтальный свайп ворксейсов именно на 4 пальца
    gesture = 3, horizontal, workspace
    
    # Дополнительные полезные параметры (по желанию):
    workspace_swipe_invert = false   # true, если хочешь инвертировать направление
    workspace_swipe_distance = 700   # чувствительность (расстояние в пикселях для полного переключения)
}




